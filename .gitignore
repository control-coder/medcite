# ===== Caches =====
.cache/
.pytest_cache/
# Ad-hoc pytest basetemp dirs. Ignored so that eval.runner._git_diff_hash, which
# hashes every untracked non-ignored file into a formal run's dirty_diff_hash,
# can never fold leftover test scratch data into run provenance.
.pytest-tmp*/
.mypy_cache/
.ruff_cache/
.cache/huggingface/

# Local formal config may contain provider-specific run metadata.
eval/config.formal.yaml

# ===== Evaluation artifacts =====
# Keep directory structure via .gitkeep, but ignore raw outputs
reports/raw/**
!reports/raw/.gitkeep
# 人工审阅界面生成目录，不属于 formal 标注产物
eval/annotations_ui/
traces/raw/*.jsonl
traces/summary/*.json

# 原始下载数据（太大，不进 git；可由 scripts/ 重新下载）
eval/datasets/raw/

# ===== Build / docs =====
site/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Local command captures used for verification
pytest-output.txt
eval-validate-output.txt
leakage-output.txt
p0b-test-output.txt
p0c-test-output.txt
p0c-provider-test-output.txt
p1a-trace-test-output.txt
p1a-trace-cli-output.txt
p1b-*-output.txt
p1b-server-error.txt

# 本地测试临时目录
.tmp/
