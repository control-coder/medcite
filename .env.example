# ===== LLM (DeepSeek, OpenAI-compatible) =====
# Locked in eval/config.yaml as generation_model. Changing requires re-running all evaluations.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# ===== Database =====
# MVP uses SQLite single-file. PostgreSQL is optional and not required for stage 1.
DATABASE_URL=sqlite:///./medidiag.db

# ===== Hugging Face 本地模型缓存 =====
# embedding：sentence-transformers/all-MiniLM-L6-v2
# rerank：   cross-encoder/ms-marco-MiniLM-L-6-v2
# judge：    cross-encoder/nli-MiniLM2-L6-H768
HF_HOME=D:/engineering_software/huggingface

# ===== Workflow runtime =====
# Lease defaults (overridable in eval/config.yaml)
MEDIDIAG_LEASE_SECONDS=60
MEDIDIAG_HEARTBEAT_SECONDS=20
MEDIDIAG_LEASE_SCAN_SECONDS=30

# ===== Logging =====
LOG_LEVEL=INFO
STRUCTLOG_DEV=1
