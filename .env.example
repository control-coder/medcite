# ===== 大模型服务配置 =====
# MiMo OpenAI-compatible profile；endpoint 以本地实际配置为准。
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=mimo-v2.6-flash

# 其他 OpenAI-compatible 网关。
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# 默认运行时 profile；可选 fake_offline/mimo_v25/openai_compatible_custom。
MEDIDIAG_LLM_PROFILE=fake_offline

# ===== 数据库 =====
# 当前实现使用 SQLite；PostgreSQL 属于后续实施轮次，尚未迁移。
DATABASE_URL=sqlite:///./medidiag.db

# ===== Hugging Face 本地模型缓存 =====
# 向量检索方案使用 BAAI/bge-small-zh-v1.5，见 configs/application_dense.yaml。
HF_HOME=.cache/huggingface

# ===== 工作流运行时 =====
# 应用运行时的租约默认值。
MEDIDIAG_LEASE_SECONDS=60
MEDIDIAG_HEARTBEAT_SECONDS=20
MEDIDIAG_LEASE_SCAN_SECONDS=30

# ===== 日志 =====
LOG_LEVEL=INFO
STRUCTLOG_DEV=1
