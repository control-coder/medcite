# ===== 大模型服务配置 =====
# 研究模型配置见 eval/config.yaml；变更后仅重跑受影响的对照，不阻塞应用交付。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# MiMo OpenAI-compatible profile；endpoint 以本地实际配置为准。
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=mimo-v2.6-flash

# 其他 OpenAI-compatible 网关。
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# 默认运行时 profile；可选 fake_offline/deepseek_default/mimo_v25/openai_compatible_custom。
MEDIDIAG_LLM_PROFILE=fake_offline

# ===== 数据库 =====
# 当前实现使用 SQLite；PostgreSQL 属于后续实施轮次，尚未迁移。
DATABASE_URL=sqlite:///./medidiag.db

# ===== Hugging Face 本地模型缓存 =====
# embedding：sentence-transformers/all-MiniLM-L6-v2
# rerank：   cross-encoder/ms-marco-MiniLM-L-6-v2
# judge：    cross-encoder/nli-MiniLM2-L6-H768
HF_HOME=.cache/huggingface

# ===== 工作流运行时 =====
# 应用运行时的租约默认值；研究评测参数独立维护在 eval/config.yaml。
MEDIDIAG_LEASE_SECONDS=60
MEDIDIAG_HEARTBEAT_SECONDS=20
MEDIDIAG_LEASE_SCAN_SECONDS=30

# ===== 日志 =====
LOG_LEVEL=INFO
STRUCTLOG_DEV=1
